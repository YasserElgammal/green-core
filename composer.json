{
    "name": "yasser-elgammal/green-core",
    "description": "Green Framework Core",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "YasserElgammal\\Green\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "YasserElgammal\\Green\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix",
        "check": ["@analyse", "@format:check", "@test"]
    },
    "authors": [
        {
            "name": "Yasser Elgammal",
            "email": "yasser.elgammal@ymail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "nikic/fast-route": "^1.3",
        "twig/twig": "^3.31.1",
        "vlucas/phpdotenv": "^5.6",
        "respect/validation": "^2.3",
        "symfony/http-foundation": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/mailer": "^7.4",
        "symfony/mime": "^7.4",
        "doctrine/dbal": "^4.4",
        "symfony/console": "^7.4",
        "predis/predis": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.90"
    }
}
